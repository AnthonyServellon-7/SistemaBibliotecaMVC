@model SistemaBibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Agregar Libro";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Libro</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Crear" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Titulo" class="control-label fw-bold">Título del Libro</label>
                    <input asp-for="Titulo" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Autor" class="control-label fw-bold">Autor</label>
                    <input asp-for="Autor" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AnioPublicacion" class="control-label fw-bold">Año de Publicación</label>
                    <input asp-for="AnioPublicacion" type="number" class="form-control" required />
                </div>

                <div class="form-group mb-4">
                    <label asp-for="ImagenUrl" class="control-label fw-bold">Nombre de Imagen (opcional)</label>
                    <input asp-for="ImagenUrl" class="form-control" placeholder="ejemplo: libro1.jpg" />
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Guardar Libro</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>