@{
    ViewData["Title"] = "Inicio";
}

<!-- Carrusel de Bootstrap para enriquecer la interfaz -->
<div id="carruselBiblioteca" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-inner rounded shadow">
        <div class="carousel-item active bg-dark text-white p-5 text-center" style="min-height: 250px; display: flex; flex-direction: column; justify-content: center;">
            <h2 class="display-4">Bienvenidos a la Biblioteca Virtual</h2>
            <p class="lead">Explora miles de libros, autores y categorías en un solo lugar.</p>
        </div>
        <div class="carousel-item bg-primary text-white p-5 text-center" style="min-height: 250px; display: flex; flex-direction: column; justify-content: center;">
            <h2 class="display-4">Nuevos Lanzamientos</h2>
            <p class="lead">Descubre las últimas adquisiciones de nuestra colección.</p>
        </div>
        <div class="carousel-item bg-success text-white p-5 text-center" style="min-height: 250px; display: flex; flex-direction: column; justify-content: center;">
            <h2 class="display-4">Préstamos Rápidos</h2>
            <p class="lead">Gestiona tus préstamos y devoluciones de manera eficiente.</p>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carruselBiblioteca" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carruselBiblioteca" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>

<!-- Sistema de Rejillas (Grid) y Tarjetas (Cards) con temática de biblioteca -->
<div class="container">
    <div class="row g-4 text-center">
        <!-- Tarjeta 1 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title text-primary">📚 Libros</h3>
                    <p class="card-text">Explora nuestro vasto catálogo de libros físicos y digitales. Contamos con obras para todas las edades y gustos literarios.</p>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-primary mt-3">Ver Catálogo</a>
                </div>
            </div>
        </div>
        <!-- Tarjeta 2 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title text-success">✍️ Autores</h3>
                    <p class="card-text">Conoce a los escritores detrás de tus historias favoritas. Consulta biografías, fechas de nacimiento y nacionalidades.</p>
                    <a asp-controller="Autores" asp-action="Index" class="btn btn-outline-success mt-3">Ver Autores</a>
                </div>
            </div>
        </div>
        <!-- Tarjeta 3 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title text-info">🔖 Categorías</h3>
                    <p class="card-text">Encuentra exactamente lo que buscas navegando por nuestras secciones de ciencia ficción, romance, historia, ciencia y más.</p>
                    <a asp-controller="Home" asp-action="Categorias" class="btn btn-outline-info mt-3">Explorar</a>
                </div>
            </div>
        </div>
    </div>
</div>