@model IEnumerable<SistemaBibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Libros</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Crear" class="btn btn-success">+ Registrar Nuevo Libro</a>
        }
    </div>

    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Portada</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Año de Publicación</th>
                @if (User.IsInRole("Admin"))
                {
                    <th class="text-center">Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var libro in Model)
                {
                    <tr>
                        <td>@libro.Id</td>
                        <td class="text-center" style="width: 80px;">
                            <img src="~/images/@libro.ImagenUrl" alt="@libro.Titulo" style="max-height: 60px;" class="img-thumbnail" />
                        </td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.AnioPublicacion</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td class="text-center">
                                <a asp-action="Editar" asp-route-id="@libro.Id" class="btn btn-warning btn-sm me-1">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@libro.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>