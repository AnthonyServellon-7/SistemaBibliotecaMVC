@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 text-center p-4">
                <div class="card-body">
                    <div class="mb-3 text-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-shield-lock-fill" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 0c-.69 0-1.382.04-2.073.115C4.017.322 2.304 1.258 1.13 2.502 1.01 2.63 1 2.784 1 2.946v3.298c0 3.328 1.832 6.541 4.707 8.358A11.758 11.758 0 0 0 8 16a11.758 11.758 0 0 0 2.293-.398C13.168 13.785 15 10.572 15 7.244V2.946c0-.162-.01-.316-.13-.444C13.696 1.258 11.983.322 10.073.115 9.382.04 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 1.5 1.5v.5h.5a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h.5v-.5A1.5 1.5 0 0 1 8 5zm-1 2v-.5a1 1 0 0 1 2 0V7H7z" />
                        </svg>
                    </div>
                    <span class="badge bg-danger mb-2 px-3 py-2 fs-6">Error 403 - Restringido</span>
                    <h2 class="card-title fw-bold text-dark mt-2">Acceso No Autorizado</h2>
                    <p class="card-text text-muted my-3">
                        No cuentas con los permisos suficientes para acceder a este recurso. Esta sección está reservada para usuarios con roles de nivel superior (Administrador o Bibliotecario).
                    </p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">
                            Ir a la Página Principal
                        </a>
                        <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                            Ver Catálogo de Libros
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>