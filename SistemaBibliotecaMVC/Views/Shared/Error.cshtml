@model ErrorViewModel
@{
    ViewData["Title"] = "Error en la aplicación";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 text-center p-4">
                <div class="card-body">
                    <div class="mb-3 text-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                    </div>
                    <h2 class="card-title fw-bold text-dark">¡Ocurrió un problema inesperado!</h2>
                    <p class="card-text text-muted my-3">
                        Hemos registrado el incidente y nuestro equipo técnico ya está al tanto. Lamentamos los inconvenientes causados en tu navegación.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-light border text-start mb-4">
                            <small class="text-secondary d-block fw-bold">Código de Referencia del Sistema:</small>
                            <code class="text-dark">@Model.RequestId</code>
                        </div>
                    }

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">
                            Volver al Inicio
                        </a>
                        <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                            Ir a Libros
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>