@model IEnumerable<SistemaBibliotecaMVC.Models.Autor>

@{
    ViewData["Title"] = "Módulo de Autores";
}

<div class="container mt-4">
    <h2>Listado de Autores</h2>
    <hr />

    <!-- Tabla con clases de Bootstrap para que quede limpia -->
    <table class="table table-striped table-hover table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Nacionalidad</th>
                <th>Fecha de Nacimiento</th>
                <th>Estado</th>
                <th>Acciones</th> <!-- Agregada la columna para los botones -->
            </tr>
        </thead>
        <tbody>
            @* Recorro la lista de autores con Razor *@
            @foreach (var autor in Model)
            {
                <tr>
                    <td>@autor.Id</td>
                    <td>@autor.Nombre</td>
                    <td>@autor.Apellido</td>
                    <td>@autor.Nacionalidad</td>
                    <td>@autor.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>
                        @* Pongo la etiqueta verde si está activo o roja si es falso *@
                        @if (autor.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <!-- Botones de acción apuntando a los métodos del controlador -->
                        <a asp-action="Editar" asp-route-id="@autor.Id" class="btn btn-primary btn-sm">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@autor.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>