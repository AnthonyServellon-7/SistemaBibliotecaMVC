@model IEnumerable<SistemaBibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Libros</h2>
        <a asp-action="Crear" class="btn btn-success">Agregar Nuevo Libro</a>
    </div>
    <hr />

    <div class="row">
        @* Recorro la lista de libros y armo una tarjeta (card) por cada uno *@
        @foreach (var libro in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <!-- Aquí se carga la imagen del libro usando la ruta de wwwroot/images -->
                    <img src="~/images/@libro.ImagenUrl" class="card-img-top" alt="Portada de @libro.Titulo" style="height: 350px; object-fit: cover;" />
                    
                    <div class="card-body">
                        <h5 class="card-title text-primary">@libro.Titulo</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Autor: @libro.Autor</h6>
                        <p class="card-text"><strong>Año de Publicación:</strong> @libro.AnioPublicacion</p>
                    </div>
                    
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <a asp-action="Detalles" asp-route-id="@libro.Id" class="btn btn-info btn-sm text-white">Detalles</a>
                        <a asp-action="Editar" asp-route-id="@libro.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@libro.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>