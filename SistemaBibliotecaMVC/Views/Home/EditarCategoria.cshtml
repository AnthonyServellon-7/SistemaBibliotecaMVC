@model SistemaBibliotecaMVC.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="container mt-4">
    <h2>Editar Categoría</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="EditarCategoria" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Descripcion" class="control-label fw-bold"></label>
                    <input asp-for="Descripcion" class="form-control" />
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-action="Categorias" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>